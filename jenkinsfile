pipeline {

    agent any

    environment {
        AWS_REGION = "us-east-1"
        TF_VERSION = "1.13.3"
        AWS_ROLE_ARN = "arn:aws:iam::672004811216:role/JenkinsDeployRole"
        TF_WORKING_DIR = "./environments/dev"
    }


    triggers {
        githubPush()
    }


    stages {


        stage('Checkout') {
            steps {
                checkout scm
            }
        }


        stage('Configure AWS Credentials') {
            steps {
                script {

                    sh '''
                    echo "Assuming AWS Role..."

                    CREDS=$(aws sts assume-role \
                    --role-arn ${AWS_ROLE_ARN} \
                    --role-session-name JenkinsTerraformSession)

                    export AWS_ACCESS_KEY_ID=$(echo $CREDS | jq -r '.Credentials.AccessKeyId')
                    export AWS_SECRET_ACCESS_KEY=$(echo $CREDS | jq -r '.Credentials.SecretAccessKey')
                    export AWS_SESSION_TOKEN=$(echo $CREDS | jq -r '.Credentials.SessionToken')

                    aws sts get-caller-identity
                    '''

                }
            }
        }


        stage('Verify AWS Identity') {
            steps {
                sh '''
                aws sts get-caller-identity
                '''
            }
        }


        stage('Terraform Version') {
            steps {
                sh '''
                terraform version
                '''
            }
        }


        stage('Terraform Init') {
            steps {
                dir("${TF_WORKING_DIR}") {
                    sh '''
                    terraform init \
                    -reconfigure \
                    -input=false
                    '''
                }
            }
        }


        stage('Terraform Format Check') {
            steps {
                dir("${TF_WORKING_DIR}") {
                    sh '''
                    terraform fmt -check -recursive
                    '''
                }
            }
        }


        stage('Terraform Validate') {
            steps {
                dir("${TF_WORKING_DIR}") {
                    sh '''
                    terraform validate -no-color
                    '''
                }
            }
        }


        stage('Check Terraform Files') {
            steps {
                sh '''
                ls -la ${TF_WORKING_DIR}

                echo "------ Terraform Variables ------"

                cat ${TF_WORKING_DIR}/terraform.tfvars
                '''
            }
        }


        stage('Terraform Plan') {
            steps {
                dir("${TF_WORKING_DIR}") {
                    sh '''
                    terraform plan \
                    -var-file="../../environments/dev/terraform.tfvars" \
                    -input=false \
                    -no-color \
                    -out=tfplan
                    '''
                }
            }
        }


        stage('Terraform Apply') {

            when {
                branch 'main'
            }

            steps {

                dir("${TF_WORKING_DIR}") {

                    sh '''
                    terraform apply \
                    -auto-approve \
                    tfplan
                    '''

                }
            }
        }

    }


    post {

        success {
            echo "Terraform pipeline completed successfully"
        }


        failure {
            echo "Terraform pipeline failed"
        }

    }

}